rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'administrador';
    }

    function isCocina() {
      return isSignedIn() && role() == 'cocina';
    }

    function isCocinaOrAdmin() {
      return isAdmin() || isCocina();
    }

    // ── productos: catálogo público de solo lectura (app de estudiantes sin login) ──
    match /productos/{productoId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.categoria in ['bebidas', 'snacks', 'almuerzos']
        && request.resource.data.precio is number && request.resource.data.precio > 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && request.resource.data.estado in ['disponible', 'agotado'];

      allow update: if isAdmin()
        && request.resource.data.categoria in ['bebidas', 'snacks', 'almuerzos']
        && request.resource.data.precio is number && request.resource.data.precio > 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && request.resource.data.estado in ['disponible', 'agotado'];

      allow delete: if isAdmin();
    }

    // ── auditoria_inventario: historial de cambios de stock, solo admin ──
    match /auditoria_inventario/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── pedidos: cocina/admin leen y cambian estado. La creación real
    // (desde la app de estudiantes, sin login) llegará vía Cloud Function
    // con Admin SDK, que no pasa por estas reglas — por eso aquí se
    // bloquea la creación directa desde el cliente.
    match /pedidos/{pedidoId} {
      allow read: if isCocinaOrAdmin();
      allow create: if false;
      allow update: if isCocinaOrAdmin()
        && request.resource.data.estado in ['en_espera', 'en_preparacion', 'listo', 'entregado', 'cancelado'];
      allow delete: if false;
    }

    // ── metricas_horas_pico: solo lectura admin por ahora ──
    match /metricas_horas_pico/{franjaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── configuracion_cupos: solo admin ──
    match /configuracion_cupos/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Cualquier otra colección: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}